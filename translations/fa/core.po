msgctxt "remove-cannot-return"
msgid "The block could not be returned to your inventory."
msgstr "بلوک به انبار برنگشت."

#: assets/i18n/en-US/core.ftl:172
msgctxt "remove-success"
msgid "Removed { $name }; 1 returned to your inventory."
msgstr "{ $name } برداشته شد؛ 1 عدد به انبار برگشت."

#: assets/i18n/en-US/core.ftl:173
msgctxt "collapse"
msgid "The structure collapsed: { $count } block(s) fell."
msgstr "سازه فرو ریخت: { $count } بلوک افتاد."

#: assets/i18n/en-US/core.ftl:177
msgctxt "plan-button"
msgid "Plan: { $built } / { $total } built"
msgstr "نقشه: { $built } از { $total } ساخته شد"


#: assets/i18n/en-US/core.ftl:98
msgctxt "hud-stage-data-unavailable"
msgid "Stage data is unavailable."
msgstr "داده‌های مرحله در دسترس نیست."

#: assets/i18n/en-US/core.ftl:99
msgctxt "hud-starting-invalid"
msgid "Starting resources are invalid: { $error }"
msgstr "منابع اولیه نامعتبرند: { $error }"

#: assets/i18n/en-US/core.ftl:100
msgctxt "hud-rules-invalid"
msgid "Block rules are invalid: { $error }"
msgstr "قوانین بلوک نامعتبرند: { $error }"

#: assets/i18n/en-US/core.ftl:101
msgctxt "hud-inventory-empty"
msgid "Inventory is empty."
msgstr "انبار خالی است."

#: assets/i18n/en-US/core.ftl:102
msgctxt "hud-none-in-inventory"
msgid "You have no { $name } in your inventory."
msgstr "در انبار خود { $name } ندارید."

#: assets/i18n/en-US/core.ftl:103
msgctxt "hud-selected"
msgid "Selected: { $name }"
msgstr "انتخاب‌شده: { $name }"

#: assets/i18n/en-US/core.ftl:104
msgctxt "hud-selected-none"
msgid "Selected: none"
msgstr "انتخاب‌شده: هیچ‌کدام"

#: assets/i18n/en-US/core.ftl:105
msgctxt "hud-selected-item"
msgid "Selected: { $name } ({ $kind })"
msgstr "انتخاب‌شده: { $name } ({ $kind })"

#: assets/i18n/en-US/core.ftl:106
msgctxt "hud-no-selectable-blocks"
msgid "This stage has no selectable blocks."
msgstr "این مرحله بلوک قابل انتخابی ندارد."

#: assets/i18n/en-US/core.ftl:107
msgctxt "hud-none-registered"
msgid "None of this stage's blocks are registered, so none can be selected."
msgstr "هیچ‌یک از بلوک‌های این مرحله ثبت نشده‌اند، پس هیچ‌کدام قابل انتخاب نیست."

#: assets/i18n/en-US/core.ftl:108
msgctxt "hud-block-list-invalid"
msgid "The stage's block list is invalid: { $error }"
msgstr "فهرست بلوک‌های مرحله نامعتبر است: { $error }"

#: assets/i18n/en-US/core.ftl:109
msgctxt "hud-tool-list-invalid"
msgid "The stage's tool list is invalid: { $error }"
msgstr "فهرست ابزارهای مرحله نامعتبر است: { $error }"

#. A block in the BLOCKS list.
#: assets/i18n/en-US/core.ftl:111
msgctxt "hud-block-row"
msgid "{ $name } - { $price } coins"
msgstr "{ $name } - { $price } سکه"

#: assets/i18n/en-US/core.ftl:112
msgctxt "hud-block-row-max"
msgid "{ $name } - { $price } coins (max { $max })"
msgstr "{ $name } - { $price } سکه (حداکثر { $max })"

#: assets/i18n/en-US/core.ftl:113
msgctxt "hud-block-row-min"
msgid "{ $name } - { $price } coins (min { $min })"
msgstr "{ $name } - { $price } سکه (حداقل { $min })"

#: assets/i18n/en-US/core.ftl:114
msgctxt "hud-block-row-minmax"
msgid "{ $name } - { $price } coins (min { $min }, max { $max })"
msgstr "{ $name } - { $price } سکه (حداقل { $min }، حداکثر { $max })"

#. A row of the INVENTORY list.
#: assets/i18n/en-US/core.ftl:116
msgctxt "hotbar-row"
msgid "[{ $kind }] { $name } x{ $quantity }"
msgstr "[{ $kind }] { $name } ×{ $quantity }"

#: assets/i18n/en-US/core.ftl:117
msgctxt "hotbar-unavailable"
msgid "[{ $kind }] { $id } x{ $quantity } - unavailable: { $reason }"
msgstr "[{ $kind }] { $id } ×{ $quantity } - در دسترس نیست: { $reason }"

#: assets/i18n/en-US/core.ftl:118
msgctxt "hotbar-not-allowed"
msgid "not allowed in this stage"
msgstr "در این مرحله مجاز نیست"

#: assets/i18n/en-US/core.ftl:119
msgctxt "hotbar-not-registered-block"
msgid "not a registered block"
msgstr "بلوک ثبت‌شده‌ای نیست"

#: assets/i18n/en-US/core.ftl:120
msgctxt "hotbar-not-registered-tool"
msgid "not a registered tool"
msgstr "ابزار ثبت‌شده‌ای نیست"

#: assets/i18n/en-US/core.ftl:121
msgctxt "hud-in-inventory"
msgid "In inventory: { $owned }"
msgstr "در انبار: { $owned }"

#: assets/i18n/en-US/core.ftl:122
msgctxt "hud-placed"
msgid "Placed: { $placed }"
msgstr "گذاشته‌شده: { $placed }"

#: assets/i18n/en-US/core.ftl:123
msgctxt "hud-placed-max"
msgid "Placed: { $placed } / { $max }"
msgstr "گذاشته‌شده: { $placed } از { $max }"

#. $mark is the next message when there is something to add.
#: assets/i18n/en-US/core.ftl:128
msgctxt "objective-line"
msgid "{ $title }: { $progress } / { $required }{ $mark }"
msgstr "{ $title }: { $progress } از { $required } { $mark }"

#: assets/i18n/en-US/core.ftl:129
msgctxt "objective-done"
msgid "(done)"
msgstr "(انجام شد)"

#: assets/i18n/en-US/core.ftl:130
msgctxt "objective-awaiting"
msgid "- solve the math challenge to finish"
msgstr "- برای پایان، چالش ریاضی را حل کنید"

#: assets/i18n/en-US/core.ftl:131
msgctxt "objectives-invalid"
msgid "Objectives are invalid: { $error }"
msgstr "هدف‌ها نامعتبرند: { $error }"

#: assets/i18n/en-US/core.ftl:135
msgctxt "challenge-counter"
msgid "Challenge { $index } / { $count }"
msgstr "چالش { $index } از { $count }"

#. The underscore is the text cursor; keep it at the end.
#: assets/i18n/en-US/core.ftl:137
msgctxt "challenge-answer"
msgid "Answer: { $input }_"
msgstr "پاسخ: { $input }_"

#: assets/i18n/en-US/core.ftl:138
msgctxt "challenge-already-solved"
msgid "Already solved."
msgstr "قبلاً حل شده است."

#: assets/i18n/en-US/core.ftl:139
msgctxt "challenge-incorrect"
msgid "Not correct. Try again."
msgstr "درست نیست. دوباره تلاش کنید."

#: assets/i18n/en-US/core.ftl:140
msgctxt "challenge-unavailable"
msgid "This challenge is no longer available."
msgstr "این چالش دیگر در دسترس نیست."

#: assets/i18n/en-US/core.ftl:144
msgctxt "shop-money"
msgid "Money: { $amount } coins"
msgstr "پول: { $amount } سکه"

#: assets/i18n/en-US/core.ftl:145
msgctxt "shop-product"
msgid "{ $name } - { $price } coins each (you own { $owned })"
msgstr "{ $name } - هر کدام { $price } سکه (شما { $owned } دارید)"

#: assets/i18n/en-US/core.ftl:146
msgctxt "shop-buy"
msgid "Buy { $quantity } for { $total } coins"
msgstr "خرید { $quantity } تا با { $total } سکه"

#: assets/i18n/en-US/core.ftl:147
msgctxt "shop-too-expensive"
msgid "Too expensive"
msgstr "خیلی گران است"

#: assets/i18n/en-US/core.ftl:148
msgctxt "shop-bought"
msgid "Bought { $quantity } x { $name } for { $total } coins."
msgstr "{ $quantity } × { $name } با { $total } سکه خریداری شد."

#: assets/i18n/en-US/core.ftl:149
msgctxt "err-quantity"
msgid "Quantity must be at least 1."
msgstr "تعداد باید دست‌کم 1 باشد."

#: assets/i18n/en-US/core.ftl:150
msgctxt "err-not-registered"
msgid "'{ $id }' is not a registered block."
msgstr "«{ $id }» بلوک ثبت‌شده‌ای نیست."

#: assets/i18n/en-US/core.ftl:151
msgctxt "err-not-sold"
msgid "'{ $id }' is not sold in this stage."
msgstr "«{ $id }» در این مرحله فروخته نمی‌شود."

#: assets/i18n/en-US/core.ftl:152
msgctxt "err-no-price"
msgid "'{ $id }' has no valid price and cannot be bought."
msgstr "«{ $id }» قیمت معتبر ندارد و خریدنی نیست."

#: assets/i18n/en-US/core.ftl:153
msgctxt "err-total-too-large"
msgid "The total price is too large."
msgstr "قیمت کل بسیار زیاد است."

#: assets/i18n/en-US/core.ftl:154
msgctxt "err-not-enough-money"
msgid "Not enough money: you need { $needed } coins but have { $balance }."
msgstr "پول کافی نیست: به { $needed } سکه نیاز دارید ولی { $balance } دارید."

#: assets/i18n/en-US/core.ftl:155
msgctxt "err-inventory-full"
msgid "Your inventory cannot hold that many."
msgstr "انبار شما گنجایش این تعداد را ندارد."

#: assets/i18n/en-US/core.ftl:159
msgctxt "err-no-selection"
msgid "No block is selected."
msgstr "هیچ بلوکی انتخاب نشده است."

#: assets/i18n/en-US/core.ftl:160
msgctxt "err-not-allowed"
msgid "'{ $id }' is not allowed in this stage."
msgstr "«{ $id }» در این مرحله مجاز نیست."

#: assets/i18n/en-US/core.ftl:161
msgctxt "err-block-unregistered"
msgid "Block '{ $id }' is not registered."
msgstr "بلوک «{ $id }» ثبت نشده است."

#: assets/i18n/en-US/core.ftl:162
msgctxt "err-outside"
msgid "That position is outside the build area."
msgstr "آن جایگاه بیرون از محدودهٔ ساخت است."

#: assets/i18n/en-US/core.ftl:163
msgctxt "err-occupied"
msgid "That space is already occupied."
msgstr "آن فضا قبلاً پر شده است."

#: assets/i18n/en-US/core.ftl:164
msgctxt "err-no-support"
msgid "No support: build on the ground or against another block."
msgstr "تکیه‌گاه ندارد: روی زمین یا کنار بلوک دیگری بسازید."

#: assets/i18n/en-US/core.ftl:165
msgctxt "err-none-left"
msgid "You have no '{ $id }' left in your inventory."
msgstr "«{ $id }» در انبارتان باقی نمانده است."

#: assets/i18n/en-US/core.ftl:166
msgctxt "err-limit"
msgid "Placement limit reached: this stage allows at most { $max } of '{ $block }'."
msgstr "به حد مجاز رسیدید: این مرحله حداکثر { $max } عدد از «{ $block }» را اجازه می‌دهد."

#: assets/i18n/en-US/core.ftl:167
msgctxt "err-invalid-placement"
msgid "Invalid placement: { $reason }"
msgstr "جایگذاری نامعتبر: { $reason }"

#: assets/i18n/en-US/core.ftl:168
msgctxt "place-could-not"
msgid "Could not place { $name }: { $error }"
msgstr "{ $name } گذاشته نشد: { $error }"

#: assets/i18n/en-US/core.ftl:169
msgctxt "place-success"
msgid "Placed { $name } at ({ $x }, { $y }, { $z })"
msgstr "{ $name } در ({ $x }، { $y }، { $z }) گذاشته شد"

